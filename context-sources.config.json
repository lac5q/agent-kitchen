{
  "sources": [
    {
      "id": "qmd",
      "type": "qmd",
      "enabled": true,
      "requiredTools": ["qmd"],
      "envVars": ["KNOWLEDGE_BASE_PATH"],
      "sourcePath": "${KNOWLEDGE_BASE_PATH:-./docs}",
      "ingestCommand": "qmd ingest",
      "indexCommand": "env QMD_FORCE_CPU=1 qmd query health --limit 1",
      "freshnessThresholdMinutes": 1440,
      "qmdCollection": "knowledge",
      "safeAnswerPolicy": "source_required"
    },
    {
      "id": "gmail",
      "type": "gmail",
      "enabled": false,
      "requiredTools": ["python3"],
      "envVars": ["GMAIL_INGEST_ENABLED"],
      "sourcePath": "./data/context/gmail",
      "ingestCommand": "python3 services/ingestion/gmail-runner.py",
      "indexCommand": "qmd index gmail",
      "freshnessThresholdMinutes": 180,
      "qmdCollection": "gmail",
      "safeAnswerPolicy": "source_required"
    },
    {
      "id": "spark",
      "type": "spark",
      "enabled": false,
      "requiredTools": ["sqlite3", "python3"],
      "envVars": ["SPARK_TRANSCRIPTS_DB", "MEMROOS_MEETING_IDENTITY_EMAILS"],
      "sourcePath": "${KNOWLEDGE_BASE_PATH:-./data/context/spark}",
      "ingestCommand": "scripts/meet-sync/meet-sync.sh --source google-spark-transcripts",
      "indexCommand": "scripts/meet-sync/meet-sync.sh --source google-spark-transcripts --skip-ingest",
      "freshnessThresholdMinutes": 360,
      "qmdCollection": "spark-recordings",
      "safeAnswerPolicy": "source_required",
      "readinessPolicy": {
        "artifactCompleteMarker": "## Transcript",
        "pendingStateKey": "pending_message_rowids",
        "ownerIdentitiesEnv": "MEMROOS_MEETING_IDENTITY_EMAILS",
        "settleMinutesEnv": "SPARK_TRANSCRIPT_SETTLE_MINUTES"
      }
    },
    {
      "id": "mem0",
      "type": "mem0",
      "enabled": true,
      "requiredTools": ["python3"],
      "envVars": ["MEM0_URL"],
      "sourcePath": "./services/memory/logs/mem0-server.log",
      "ingestCommand": "services/memory/healthcheck.sh",
      "indexCommand": "curl -fsS ${MEM0_URL:-http://localhost:3201}/health",
      "freshnessThresholdMinutes": 15,
      "qmdCollection": null,
      "safeAnswerPolicy": "degrade_with_warning"
    },
    {
      "id": "local-folder",
      "type": "local-folder",
      "enabled": false,
      "requiredTools": [],
      "envVars": ["LOCAL_CONTEXT_PATH"],
      "sourcePath": "${LOCAL_CONTEXT_PATH:-./docs}",
      "ingestCommand": null,
      "indexCommand": "qmd index local-folder",
      "freshnessThresholdMinutes": 1440,
      "qmdCollection": "local-folder",
      "safeAnswerPolicy": "source_required"
    },
    {
      "id": "meet-recordings",
      "type": "qmd",
      "enabled": false,
      "requiredTools": [],
      "envVars": [],
      "sourcePath": "${KNOWLEDGE_BASE_PATH:-./data/context/meet-recordings}",
      "ingestCommand": "scripts/meet-sync/meet-sync.sh --source google-spark-transcripts",
      "indexCommand": "scripts/meet-sync/meet-sync.sh --source google-spark-transcripts --skip-ingest",
      "freshnessThresholdMinutes": 360,
      "qmdCollection": "meet-recordings",
      "safeAnswerPolicy": "source_required",
      "_comment": "Google Meet / Gemini notes. Enable via ~/.memroos/context-sources.local.json + meeting-sources.json."
    },
    {
      "id": "meet-recordings-circleback",
      "type": "qmd",
      "enabled": false,
      "requiredTools": ["circleback", "python3"],
      "envVars": [],
      "sourcePath": "./data/context/meet-recordings-circleback",
      "ingestCommand": "scripts/meet-sync/meet-sync.sh --source circleback",
      "indexCommand": "scripts/meet-sync/meet-sync.sh --source circleback --skip-ingest",
      "freshnessThresholdMinutes": 360,
      "qmdCollection": "meet-recordings-circleback",
      "safeAnswerPolicy": "source_required"
    },
    {
      "id": "meet-recordings-fathom",
      "type": "qmd",
      "enabled": false,
      "requiredTools": ["python3", "curl"],
      "envVars": ["FATHOM_API_KEY"],
      "sourcePath": "./data/context/meet-recordings-fathom",
      "ingestCommand": "scripts/meet-sync/meet-sync.sh --source meet-recordings-fathom",
      "indexCommand": "scripts/meet-sync/meet-sync.sh --source meet-recordings-fathom --skip-ingest",
      "freshnessThresholdMinutes": 360,
      "qmdCollection": "meet-recordings-fathom",
      "safeAnswerPolicy": "source_required",
      "_comment": "Generic single-account Fathom stub. Multi-account operators overlay epilogue/personal ids."
    },
    {
      "id": "meet-recordings-zoom",
      "type": "qmd",
      "enabled": false,
      "requiredTools": ["python3", "curl"],
      "envVars": ["ZOOM_ACCOUNT_ID", "ZOOM_CLIENT_ID", "ZOOM_CLIENT_SECRET"],
      "sourcePath": "./data/context/meet-recordings-zoom",
      "ingestCommand": "scripts/meet-sync/meet-sync.sh --source zoom",
      "indexCommand": "scripts/meet-sync/meet-sync.sh --source zoom --skip-ingest",
      "freshnessThresholdMinutes": 1440,
      "qmdCollection": "meet-recordings-zoom",
      "safeAnswerPolicy": "source_required"
    }
  ]
}
