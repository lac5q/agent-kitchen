# Mem0 Environment Variables
QDRANT_URL=https://your-qdrant-cloud-endpoint
QDRANT_API_KEY=${QDRANT_API_KEY:-your-qdrant-api-key}
OLLAMA_BASE_URL=http://localhost:11434

# PII storage guard. "presidio" uses local Microsoft Presidio when installed
# and falls back to deterministic local redaction if packages/models are absent.
# Use "local" to skip NLP model load, or "off" only for isolated tests.
MEMROOS_PII_MODE=presidio
MEMROOS_PII_LANGUAGE=en
MEMROOS_PII_MAX_CHARS=8000

# Neo4j is cloud-only (Aura Free tier). mem0 does not use these directly;
# they are consumed by the Memroos Next.js app for graph memory.
NEO4J_HTTP_URL=https://your-neo4j-aura-instance.databases.neo4j.io
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-aura-password

# Optional alert sinks used by services/memory/healthcheck.sh.
# Set at least one sink if you want launchd/cron degradation notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_KNOWLEDGE_WEBHOOK=
