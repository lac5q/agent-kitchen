[Unit]
Description=MemroOS mem0-memory (oracle-1 production)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=opc
Group=opc
ExecStart=/usr/local/bin/memroos-mem0-memory.sh
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
