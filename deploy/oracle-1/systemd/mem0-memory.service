[Unit]
Description=MemroOS mem0-memory (oracle-1 production)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=notify
User=opc
Group=opc
# TOPOPROD-02: the systemd unit must bring up the named
# docker-compose service. The runtime-topology gate asserts
# `docker compose up <service>` is in the ExecStart.
ExecStart=/usr/bin/docker compose -f /home/opc/memroos/docker-compose.yml up mem0-memory
ExecStop=/usr/bin/docker compose -f /home/opc/memroos/docker-compose.yml stop mem0-memory
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
