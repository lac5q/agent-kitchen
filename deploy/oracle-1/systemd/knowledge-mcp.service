[Unit]
Description=MemroOS knowledge-mcp (oracle-1 production)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
# docker compose does not sd_notify; Type=notify made every start fail
# with "did not take the steps required by its unit configuration".
Type=simple
User=opc
Group=opc
# TOPOPROD-02: the systemd unit must bring up the named
# docker-compose service. The runtime-topology gate asserts
# `docker compose up <service>` is in the ExecStart.
ExecStart=/usr/bin/docker compose -f /home/opc/memroos/docker-compose.yml up knowledge-mcp
ExecStop=/usr/bin/docker compose -f /home/opc/memroos/docker-compose.yml stop knowledge-mcp
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
