{
  "name": "memroos-monorepo",
  "version": "1.0.0-beta.2",
  "private": true,
  "packageManager": "npm@11.12.1",
  "license": "SEE LICENSE IN LICENSE",
  "bin": {
    "memroos": "./bin/memroos.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "22.x",
    "npm": "11.x"
  },
  "scripts": {
    "heroku-postbuild": "npm ci --include=dev && npm install @rolldown/binding-linux-x64-gnu @tailwindcss/oxide-linux-x64-gnu @unrs/resolver-binding-linux-x64-gnu --no-save && npm rebuild --workspace apps/memroos better-sqlite3 && npm run build",
    "dev": "npm --prefix apps/memroos run dev --",
    "build": "npm --prefix apps/memroos run build",
    "typecheck": "npm --prefix apps/memroos run typecheck",
    "start": "npm --prefix apps/memroos run start -- --port 3002",
    "start:all": "bash start.sh",
    "mcp": "bash scripts/memroos-mcp.sh",
    "mcp:http": "bash scripts/memroos-mcp.sh --http --host 0.0.0.0 --port ${MEMROOS_MCP_PORT:-8765}",
    "handoff:goal-state": "bash scripts/memroos-goal-state-handoff.sh",
    "install:mcp:chatgpt": "bash scripts/install-chatgpt-mcp-launchd.sh",
    "install:memory-resilience": "node scripts/install-memory-resilience.mjs install",
    "setup:codex-cloud": "bash scripts/setup-codex-cloud.sh",
    "setup:cursor-cloud": "bash scripts/setup-cursor-cloud.sh",
    "check:cursor-coding-env": "node scripts/check-cursor-coding-env.mjs",
    "test": "npm --prefix apps/memroos run test --",
    "test:fast": "npm run test -- --run",
    "test:slow": "npm --prefix apps/memroos run test:slow --",
    "test:gate": "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" npm --prefix apps/memroos run test:fast",
    "eval:context-sources": "node scripts/run-context-source-evals.mjs",
    "eval:knowledge-save-contract": "node scripts/check-knowledge-save-contract.mjs --fixture evals/knowledge-save-contract/cases.json",
    "eval:memory-degradation": "bash scripts/run-memory-degradation-checks.sh",
    "eval:marketplace-memory": "node scripts/run-marketplace-memory-evals.mjs",
    "eval:comparative-retrieval": "node scripts/run-comparative-retrieval-evals.mjs",
    "generate:runtime-bottleneck-manifest": "node scripts/generate-runtime-bottleneck-manifest.mjs",
    "check:runtime-bottleneck-evidence": "node scripts/check-runtime-bottleneck-evidence.mjs",
    "check:governance": "node scripts/check-governance-coverage.mjs",
    "check:knowledge-indexing": "node scripts/check-knowledge-indexing.mjs",
    "check:local-footprint": "node scripts/check-local-footprint.mjs",
    "retention:expiry": "node scripts/run-retention-expiry.mjs",
    "graph:catchup": "node scripts/run-graph-catchup.mjs",
    "graph:catchup:cron": "node scripts/run-graph-catchup-cron.mjs",
    "wiki:digest": "node scripts/run-wiki-digest.mjs",
    "wiki:digest:cron": "node scripts/run-wiki-digest-cron.mjs",
    "observe:sidecar": "node scripts/run-observe-sidecar.mjs",
    "check:runtime-topology": "node scripts/check-runtime-topology.mjs",
    "check:contracts": "node scripts/check-contract-manifest.mjs",
    "check:lib-boundary": "node scripts/check-lib-boundary.mjs && node --test scripts/check-lib-boundary.test.mjs",
    "check:sqlite-allowlist": "node scripts/check-sqlite-allowlist.mjs && node --test scripts/check-sqlite-allowlist.test.mjs",
    "check:route-auth-boundary": "node scripts/check-route-auth-boundary.mjs && node --test scripts/check-route-auth-boundary.test.mjs && npm run test --workspace apps/memroos -- --run src/lib/__tests__/operator-auth.test.ts src/app/api/agent-context/__tests__/route.test.ts src/app/api/agent-checkpoints/__tests__/route.test.ts src/app/api/agent-memory/traces/__tests__/route.test.ts src/app/api/agent-runtime/observability/__tests__/route.test.ts src/app/api/agents/versions/__tests__/route.test.ts src/app/api/hive/__tests__/route.test.ts src/app/api/model-routing/__tests__/route.test.ts",
    "check:next-trust-boundary": "node scripts/check-next-trust-boundary.mjs && npm run test --workspace apps/memroos -- --run src/__tests__/proxy.test.ts src/app/api/agent-checkpoints/__tests__/route.test.ts src/app/api/agent-memory/traces/__tests__/route.test.ts src/app/api/agent-runtime/observability/__tests__/route.test.ts src/app/api/agents/versions/__tests__/route.test.ts src/app/api/hive/__tests__/route.test.ts src/app/api/model-routing/__tests__/route.test.ts",
    "check:future-spikes": "node scripts/check-future-spikes.mjs && node --test scripts/check-future-spikes.test.mjs",
    "check:operator-load-slo": "node scripts/check-operator-load-slo.mjs && node --test scripts/check-operator-load-slo.test.mjs",
    "check:a2a-schema": "npm run test --workspace apps/memroos -- --run src/lib/a2a/__tests__/contract.test.ts src/lib/a2a/__tests__/agent-card.test.ts src/app/api/a2a/openapi/__tests__/route.test.ts",
    "check:mcp-schema": ".venv/bin/python -m pytest services/knowledge-mcp/tests/test_knowledge_system.py -q",
    "check:recall-canary": "npm run test --workspace apps/memroos -- --run src/lib/__tests__/memory-recall-evals.test.ts src/lib/__tests__/memory-recall-canary-ci.test.ts",
    "check:policy-regression": "npm run test --workspace apps/memroos -- --run src/lib/policy/__tests__/regression.test.ts",
    "check:belief-eval": "npm run test --workspace apps/memroos -- --run src/lib/__tests__/belief-promotion-eval-ci.test.ts",
    "check:gsd-lane-evals": "npm run test --workspace apps/memroos -- --run src/lib/__tests__/gsd-phase135.test.ts src/lib/__tests__/gsd-lane-evals-ci.test.ts",
    "check:recall-anchors": "node scripts/check-recall-anchors.mjs --skip-mem0",
    "check:recall-anchors:live": "node scripts/check-recall-anchors.mjs --require-mem0",
    "install:runtime-services": "node scripts/install-runtime-services.mjs install",
    "sync:fathom": "bash scripts/integrations/fathom/fathom-sync.sh",
    "check:runtime-services": "node scripts/install-runtime-services.mjs check && node --test scripts/install-runtime-services.test.mjs",
    "setup:multica-memroos": "node scripts/setup-multica-memroos.mjs",
    "lint": "npm --prefix apps/memroos run lint",
    "check:agents": "node scripts/check-agent-systems.mjs",
    "curate:skills": "node scripts/curate-agent-skills.mjs",
    "install:skill-curation": "node scripts/install-skill-curation-launchd.mjs",
    "profiles:check": "node scripts/validate-operating-profiles.mjs",
    "first-run:check": "node scripts/first-run-wizard.mjs --check",
    "setup": "bash install.sh",
    "check:roadmap-priority": "node scripts/check-roadmap-priority.mjs",
    "check:onboarding-deploy": "bash scripts/verify-onboarding-deploy.sh",
    "check:observe-maturity-drift": "node scripts/check-observe-maturity-drift.mjs && node --test scripts/check-observe-maturity-drift.test.mjs"
  },
  "overrides": {
    "ip-address": "10.2.0",
    "postcss": "8.5.14"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0"
  }
}
