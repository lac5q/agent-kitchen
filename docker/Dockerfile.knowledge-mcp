FROM python:3.11-slim
WORKDIR /app
COPY services/knowledge-mcp/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
# Preserve the repo layout: mcp_server.py resolves services/memory/provenance.py
# as a sibling of services/knowledge-mcp (parents[2]/memory). The importable
# package is knowledge_system, so PYTHONPATH points inside the hyphenated dir.
COPY services/knowledge-mcp /app/services/knowledge-mcp
COPY services/memory/provenance.py /app/services/memory/provenance.py
ENV PYTHONPATH=/app/services/knowledge-mcp
ENV MEMROOS_MCP_TRANSPORT=streamable-http
ENV MEMROOS_MCP_HOST=0.0.0.0
ENV MEMROOS_MCP_PORT=3291
EXPOSE 3291
CMD ["python", "-m", "knowledge_system.mcp_server"]
