FROM python:3.11-slim
WORKDIR /app
COPY services/knowledge-mcp/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY services/knowledge-mcp ./services/knowledge-mcp
ENV PYTHONPATH=/app
EXPOSE 3291
CMD ["python", "-m", "uvicorn", "services.knowledge_mcp.knowledge_system.app:app", "--host", "0.0.0.0", "--port", "3291"]
