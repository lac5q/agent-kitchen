FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/memroos/package.json apps/memroos/package.json
RUN npm ci --workspace apps/memroos --include-workspace-root --ignore-scripts
ARG LIGHTNINGCSS_VERSION=1.32.0
ARG TAILWINDCSS_OXIDE_VERSION=4.2.4
RUN node -e "const arch = process.arch; if (arch === 'arm64' || arch === 'x64') console.log(['lightningcss-linux-' + arch + '-gnu@' + process.env.LIGHTNINGCSS_VERSION, '@tailwindcss/oxide-linux-' + arch + '-gnu@' + process.env.TAILWINDCSS_OXIDE_VERSION].join(' '))" \
  | xargs -r npm install --workspace apps/memroos --no-save --ignore-scripts
RUN npm rebuild --workspace apps/memroos better-sqlite3

FROM node:22-bookworm-slim AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY agents.config.json ./agents.config.json
COPY apps/memroos apps/memroos
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm --workspace apps/memroos run build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV npm_config_user_agent="npm/11.12.1 node/v22 linux x64 workspaces/false"
COPY --from=builder /app/package.json /app/package-lock.json ./
# agents.config.json seeds `registered_agents` on first boot
# (lib/agent-registry-seed.ts, via findConfigFile → repo root). It was never
# copied into the image, so seedRegisteredAgents() hit its catch and returned
# silently: cordant-hermes-01 came up with 0 agents in every agent table, and
# the hardcoded workflow map masked it by drawing five names that were not
# there. Missing file still degrades gracefully — this only makes the seed
# possible, it does not make it required.
COPY --from=builder /app/agents.config.json ./agents.config.json
COPY --from=builder /app/apps/memroos/package.json ./apps/memroos/package.json
COPY --from=builder /app/apps/memroos/.next ./apps/memroos/.next
COPY --from=builder /app/apps/memroos/public ./apps/memroos/public
COPY --from=deps /app/node_modules ./node_modules
EXPOSE 3000
CMD ["npm", "--workspace", "apps/memroos", "run", "start", "--", "--hostname", "0.0.0.0", "--port", "3000"]
