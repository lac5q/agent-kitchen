{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memroos.com/schemas/runtime-bottleneck-decision.schema.json",
  "title": "MemroOS Runtime Bottleneck Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "decision", "evidence", "thresholds"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "decision": { "enum": ["keep", "optimize-current-stack", "bounded-shadow-extraction"] },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suiteManifest", "operatorRuns", "retrievalRuns", "profiles", "heaps", "traces", "attribution"],
      "properties": {
        "suiteManifest": { "type": "string", "minLength": 1 },
        "operatorRuns": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
        "retrievalRuns": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
        "profiles": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
        "heaps": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
        "traces": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
        "attribution": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p95MaxMs", "errorRateMax", "localShareMin", "remoteAndUnknownShareMax"],
      "properties": {
        "p95MaxMs": { "const": 500 },
        "errorRateMax": { "const": 0.001 },
        "localShareMin": { "const": 0.6 },
        "remoteAndUnknownShareMax": { "const": 0.4 }
      }
    },
    "limitingComponent": { "type": "string", "minLength": 1 },
    "currentStackChange": { "type": "string", "minLength": 1 },
    "boundedInterface": { "type": "string", "minLength": 1 },
    "shadowOnlyBoundary": { "type": "string", "minLength": 1 },
    "rollbackCriteria": { "type": "string", "minLength": 1 },
    "comparisonMetrics": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "optimize-current-stack" } } },
      "then": { "required": ["limitingComponent", "currentStackChange"] }
    },
    {
      "if": { "properties": { "decision": { "const": "bounded-shadow-extraction" } } },
      "then": { "required": ["limitingComponent", "boundedInterface", "shadowOnlyBoundary", "rollbackCriteria", "comparisonMetrics"] }
    }
  ]
}
