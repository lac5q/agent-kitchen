# MemroOS — Environment Configuration
# Copy this to .env.local and update paths for your system

# ── Knowledge Base ──────────────────────────────────────────────────────────
# Path to your knowledge repository (QMD collections).
# The default below is Linux-portable (`$HOME`-anchored). Override for macOS,
# custom layouts, or container bind mounts. The installer prompts on first run.
KNOWLEDGE_BASE_PATH=${HOME}/github/knowledge

# ── Agent Configs ────────────────────────────────────────────────────────────
# Path to agent config directories (each subfolder = one agent).
# Convention: must be a subdir of KNOWLEDGE_BASE_PATH. Default sits alongside
# the knowledge base at <knowledge>/agent-configs. Override only if you keep
# agent configs outside the knowledge repo, and set AGENT_CONFIGS_HOST_PATH
# to the host path that should be bind-mounted at /agent-configs inside the
# container. Both must point at the same directory.
AGENT_CONFIGS_PATH=${HOME}/github/knowledge/agent-configs
# Only used when agent configs live OUTSIDE the knowledge repo. Leave unset
# (defaults to a harmless /dev/null bind) for the standard subdir layout.
# Setting this also requires MEMROOS_AGENT_CONFIGS_CONTAINER_PATH below.
# AGENT_CONFIGS_HOST_PATH=${HOME}/github/agent-configs
# In-container path for the optional independent layout. Unset = default
# subdir (<knowledge>/agent-configs). Set to /agent-configs only when
# AGENT_CONFIGS_HOST_PATH points at a directory outside the knowledge repo.
# MEMROOS_AGENT_CONFIGS_CONTAINER_PATH=/agent-configs

# ── Memory ───────────────────────────────────────────────────────────────────
# Path to Claude Code projects directory (auto-memory files)
CLAUDE_MEMORY_PATH=${HOME}/.claude/projects

# mem0 semantic memory API
MEM0_URL=http://localhost:3201
MEM0_PORT=3201

# Unified memory tiers (Phase 37): vector=mem0/Qdrant Cloud, graph=mem0/Neo4j,
# episodic=Memroos SQLite. Qdrant and Neo4j are cloud-only.
QDRANT_URL=https://your-qdrant-cloud-endpoint
QDRANT_API_KEY=your-qdrant-cloud-api-key
NEO4J_HTTP_URL=https://your-neo4j-aura-instance.databases.neo4j.io
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-aura-password

# Local mem0 model service
# Ollama must have qwen2.5:3b and nomic-embed-text pulled locally.
OLLAMA_BASE_URL=http://localhost:11434

# ── Local ollama vs cloud: docker compose profile ──────────────────────────
# The local stack ships with two COMPOSE_PROFILES:
#   (default) = cloud.   ollama + ollama-pull services are SKIPPED.
#                       Set OLLAMA_BASE_URL to a remote ollama endpoint.
#   local     = the local 2.7GB CUDA image is started (needs ~4G disk free).
#                       Use `COMPOSE_PROFILES=local docker compose up -d`.
# install.sh auto-detects: if disk free < 5G, falls back to the cloud
# profile and writes a `MEMROOS_OLLAMA_MODE=cloud` marker into .env.
MEMROOS_OLLAMA_MODE=cloud
# Override (set explicitly):
#   local     = use bundled ollama (default for hosts with >=5G free disk)
#   cloud     = skip ollama, point at OLLAMA_BASE_URL above
#   skip      = don't run ollama at all; mem0 falls back to its default
# MEMROOS_OLLAMA_MODE=local

# ── Package options: embeddings + Hermes dual-mode ───────────────────────────
# Full matrix: docs/package-options-embeddings-hermes-memory.md
#
# Embeddings (apps/memroos typed env — MEMROOS_EMBEDDING_PROVIDER):
#   null   = default; no embed API calls; no local model required
#   ollama = local nomic-embed-text via OLLAMA_URL (needs disk/RAM)
#   voyage = PLANNED cloud HTTP API — NOT implemented yet (do not set)
#
# MEMROOS_EMBEDDING_PROVIDER=null
# MEMROOS_EMBEDDING_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
#
# Voyage (future — document-only until shipped):
# VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-4-large
# Pricing reference (2026-07-16): voyage-4-large $0.12/1M tokens after 200M free
#   https://docs.voyageai.com/docs/pricing
#
# Hermes memory dual-mode (opt-in; default = built-in MEMORY.md only):
#   bash scripts/install-hermes-memroos-memory.sh
#   hermes config set memory.provider memroos   # activate observe mirror
#   hermes memory off                           # back to built-in only
#   MEMROOS_HERMES_DRY_RUN=1                    # receipts only, no HTTP
# Docs: docs/integrations/hermes-memory-dual-mode.md

# Memory resilience monitors. macOS setup installs launchd monitors by default.
# Set INSTALL_MEMORY_RESILIENCE=0 to skip. Configure one remote alert sink if
# you want off-machine notifications; otherwise local macOS notifications are used.
INSTALL_MEMORY_RESILIENCE=1

# ── Universal Notifications ──────────────────────────────────────────────────
# memroos.notify fans alerts out to whichever channels are configured.
# Local alerts.log is ALWAYS written as a universal fallback — set and forget.
# To opt into a channel, fill in its env var below. Multiple channels work.
#
# NOTIFY_DISCORD_WEBHOOK   = Discord incoming webhook URL
# NOTIFY_TELEGRAM_BOT_TOKEN = Telegram bot token from @BotFather
# NOTIFY_TELEGRAM_CHAT_ID  = Your numeric chat ID (DM the bot, check getUpdates)
# NOTIFY_SLACK_WEBHOOK     = Slack incoming webhook URL
# NOTIFY_MACOS=1           = Enable native macOS Notification Center (default on darwin)
# NOTIFY_FILE_PATH         = Override local alerts log path (default: ./logs/alerts.log)
#
# Example (uncomment and fill to enable Discord):
# NOTIFY_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...

# Legacy aliases (still respected by older monitors — keep them too)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_KNOWLEDGE_WEBHOOK=

# ── APO (Agent Lightning) ────────────────────────────────────────────────────
# Path to APO proposal files. Linux default below; override on macOS if needed.
APO_PROPOSALS_PATH=${HOME}/.openclaw/skills/proposals

# Path to Agent Lightning cron log
APO_CRON_LOG_PATH=${HOME}/.openclaw/logs/agent-lightning-cron.log

# ── Remote Agents ─────────────────────────────────────────────────────────────
# Remote agents are configured in agents.config.json (no env vars needed)
# To add agents, edit agents.config.json

# ── Operator Registry Writes ─────────────────────────────────────────────────
# Required for registry registration/deregistration when Memroos is not accessed
# through localhost. Leave unset for local-dev loopback-only registration.
# MEMROOS_OPERATOR_API_KEY=change-me

# ── Tool Authentication Plane (Phase 179 / v8.23) ──────────────────────────
# Nango secret key for OAuth + API-key auth orchestration.
# Get one at https://app.nango.dev (free tier covers ≤10 connections per install).
# Without this, /api/tools/* returns 503 "nango_not_configured" and the
# Connected Tools settings page degrades to vault-only connections.
# NANGO_SECRET_KEY=your-nango-secret-key

# ── A2A Hub (Phase 35) ──────────────────────────────────────────────────────
# local-dev | single-host | private-network | cloud-https | custom
MEMROOS_A2A_PROFILE=local-dev
MEMROOS_PORT=3000
MEMROOS_PUBLIC_BASE_URL=http://localhost:3000
MEMROOS_A2A_ENDPOINT_BASE_URL=http://localhost:3000
MEMROOS_A2A_REMOTE_CARD_TIMEOUT_MS=5000
MEMROOS_A2A_ALLOW_PRIVATE_NETWORK_CARDS=true
MEMROOS_A2A_ADK_FIXTURE_CARD_URL=http://localhost:8001/a2a/check_prime_agent/.well-known/agent-card.json

# ── LangGraph Orchestration (Phase 36) ──────────────────────────────────────
ORCHESTRATION_SERVICE_URL=http://localhost:3210
ORCHESTRATION_PORT=3210
ORCHESTRATION_DB_PATH=data/orchestration.db
ORCHESTRATION_RETRY_LIMIT=2
# Checkpointer backend: sqlite (default, SqliteSaver) or postgres (future flag,
# not yet implemented — see docs/integrations/langgraph.md → "Option B").
ORCHESTRATION_CHECKPOINTER=sqlite
# Postgres DSN for ORCHESTRATION_CHECKPOINTER=postgres (future, not implemented)
# ORCHESTRATION_POSTGRES_DSN=YOUR_POSTGRES_DSN_HERE

# ── Litestream checkpoint durability (Phase 144, FLEET-11) ──────────────────
# See services/orchestration/litestream.yml.example for the replication config.
# These are used by the litestream sidecar, not the orchestration service itself.
# LITESTREAM_BUCKET=orchestration-checkpoints
# LITESTREAM_ENDPOINT=https://your-s3-compatible-endpoint
# LITESTREAM_REGION=us-east-1
# LITESTREAM_ACCESS_KEY_ID=your-access-key
# LITESTREAM_SECRET_ACCESS_KEY=your-secret-key

# ── Optional: Override config file paths ────────────────────────────────────
# AGENTS_CONFIG_PATH=./agents.config.json
# COLLECTIONS_CONFIG_PATH=./collections.config.json
CONTEXT_SOURCES_CONFIG=./context-sources.config.json

# ── Public Web Analytics ─────────────────────────────────────────────────────
# Google Analytics 4 measurement ID for the public Next.js app.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Context Source Contracts (Phase 69) ─────────────────────────────────────
GMAIL_INGEST_ENABLED=0
SPARK_TRANSCRIPTS_DB=
LOCAL_CONTEXT_PATH=./docs

# ── Provider-agnostic Message Memory ─────────────────────────────────────────
# Optional config file copied from message-memory.config.example.json.
MESSAGE_MEMORY_CONFIG=./message-memory.config.json
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
MESSAGE_MEMORY_SLACK_ALLOW_TEAM_IDS=
MESSAGE_MEMORY_SLACK_INCLUDE_BOT_MESSAGES=0
MESSAGE_MEMORY_SLACK_MAX_SKEW_SECONDS=300

# ── Public Eval API (Phase 62) ───────────────────────────────────────────────
# URL used by the internal SDK client for dogfood calls (SEAL/autogen loop).
MEMROOS_PUBLIC_API_URL=http://localhost:3000
# Pre-seeded API key for internal dogfood calls.
# Generate with: openssl rand -hex 32
MEMROOS_INTERNAL_API_KEY=<generate-with-openssl-rand-hex-32>

# ── Self-hosted Compliance / Data Residency (Phase 66) ──────────────────────
# When enabled, judge/model calls must use a configured local endpoint.
MEMROOS_DATA_RESIDENCY=0
LOCAL_JUDGE_PROVIDER=ollama
LOCAL_JUDGE_ENDPOINT=http://localhost:11434/v1
LOCAL_JUDGE_MODEL=hermes3
AUDIT_RETENTION_DAYS=365

# ── Team Auth (Phase 63) ─────────────────────────────────────────────────────
# HS256 secret for JWT access tokens — generate with: openssl rand -base64 32
MEMROOS_JWT_SECRET=change-me-to-a-random-32-char-string
# First-run admin seed: if no users exist, create admin with these credentials
MEMROOS_ADMIN_EMAIL=admin@example.com
MEMROOS_ADMIN_PASSWORD=change-me-strong-password
# Base URL used for invite link generation (defaults to request Host header)
# MEMROOS_BASE_URL=https://your-domain.com
# Set only when a trusted platform/proxy overwrites client IP headers.
AUTH_TRUST_PROXY_HEADERS=0

# ── Optional Progressive Capabilities ────────────────────────────────────────
# Comma-separated opt-in checks for bundled-but-optional capabilities.
# Supported: gitnexus, agent-lightning
MEMROOS_OPTIONAL_CAPABILITIES=

# GitNexus code graph registry
GITNEXUS_REGISTRY=${HOME}/.gitnexus/registry.json

# ── Memory Intelligence (Phase 23) ───────────────────────────────────────────
# Anthropic API key for LLM consolidation engine (MEM-01)
ANTHROPIC_API_KEY=your-key-here

# Model used for memory consolidation (insight extraction).
# Default: claude-haiku-4-5-20251001 (cheapest Anthropic option).
# Must be an Anthropic model ID — Gemini/Minimax not yet supported.
CONSOLIDATION_MODEL=claude-haiku-4-5-20251001

# ── Voice / Gemini ───────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-key-here
VOICE_MODE=gemini
VOICE_WS_PORT=7860
VOICE_HEALTH_PORT=7861

# ── Multi-source ingest paths (Phase 23) ─────────────────────────────────────
# Override default session storage paths if yours differ
QWEN_MEMORY_PATH=${HOME}/.qwen/projects
HERMES_MEMORY_PATH=${HOME}/.hermes/sessions
CODEX_MEMORY_PATH=${HOME}/.codex/sessions

# ── Paperclip Tenant Integration (Phase 146, FLEET-17..21) ──────────────────
# Paperclip is a parallel tenant (companies, issues, budgets, board).
# MemroOS proxies fleet status, dispatch, and budget reads; it does NOT
# re-implement Paperclip board UX or budget hard-stops.
# Leave unset to degrade gracefully (endpoints return 503).
# PAPERCLIP_BASE_URL=http://localhost:3100
# PAPERCLIP_STATUS_PATH=/api/fleet
# PAPERCLIP_DISPATCH_PATH=/api/dispatch
# PAPERCLIP_BUDGET_PATH=/api/budget

# ── Fathom meet-recordings (dual-account; prefer 1Password) ─────────────────
# Install: bash scripts/integrations/fathom/install-local.sh --probe
# Default accounts config: ~/.memroos/integrations/fathom-accounts.json
# FATHOM_ACCOUNTS_CONFIG=~/.memroos/integrations/fathom-accounts.json
# Optional raw key overrides (skip op read when set):
# FATHOM_API_KEY_EPILOGUE=
# FATHOM_API_KEY_GMAIL=
# Headless 1Password (cron / cloud):
# OP_SERVICE_ACCOUNT_TOKEN=
