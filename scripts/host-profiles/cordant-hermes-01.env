# cordant-hermes-01 — the v8.21 deploy target.
#
# Runs its own local Neo4j rather than Aura. This is INTENTIONAL, decided
# 2026-07-26 (HOSTPAR-04): the host has no verified backup, so migrating its
# graph data would violate the standing no-data-loss rule. Revisit if
# cross-host graph recall becomes a requirement or a restore rehearsal exists.
MEMROOS_HOST_ID=cordant-hermes-01
EXPECT_GRAPH_BACKEND=local
EXPECT_VECTOR_BACKEND=none
EXPECT_LOCAL_NEO4J_RUNNING=yes
CONTAINER_NAME=memroos-local-memroos-1
ALERT_EMAIL=luis@epiloguecapital.com
