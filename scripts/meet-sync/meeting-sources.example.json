{
  "_comment": "Copy to ~/.memroos/meeting-sources.json (never commit). Secrets stay in envFile / 1Password refs, not here. Runner: scripts/meet-sync/meet-sync.sh",
  "version": 1,
  "defaults": {
    "embed": true,
    "ensureCollection": true
  },
  "sources": [
    {
      "id": "google-spark-transcripts",
      "enabled": false,
      "provider": "personal-transcripts",
      "ingestCommand": "$HOME/github/knowledge/personal-ingestion-transcripts.sh",
      "envFile": null,
      "outputDir": null,
      "qmdCollections": ["meet-recordings", "spark-recordings"],
      "schedule": { "hour": 7, "minute": 0 },
      "freshnessThresholdMinutes": 180,
      "requiredTools": ["python3", "gws", "sqlite3"],
      "envVars": [],
      "_comment": "Google Meet (Gemini notes via gws) + Spark Desktop transcripts. Ingest owns knowledge paths."
    },
    {
      "id": "circleback",
      "enabled": false,
      "provider": "circleback",
      "ingestCommand": "$HOME/.memroos/integrations/circleback-ingest.sh",
      "envFile": null,
      "outputDir": "$HOME/github/memroos/data/context/meet-recordings-circleback",
      "qmdCollections": ["meet-recordings-circleback"],
      "schedule": { "hour": 6, "minute": 0 },
      "freshnessThresholdMinutes": 360,
      "requiredTools": ["circleback", "python3"],
      "envVars": [],
      "_comment": "Circleback.ai client meetings. Separate collection from Google Meet."
    },
    {
      "id": "fathom-epilogue",
      "enabled": false,
      "provider": "fathom",
      "ingestCommand": "$HOME/.memroos/integrations/fathom-epilogue-ingest.sh",
      "envFile": "$HOME/.memroos/agent-keys/fathom-epilogue.env",
      "outputDir": "$HOME/github/memroos/data/context/meet-recordings-epilogue",
      "qmdCollections": ["meet-recordings-epilogue"],
      "schedule": { "hour": 3, "minute": 0 },
      "freshnessThresholdMinutes": 360,
      "requiredTools": ["curl", "python3", "op"],
      "envVars": ["FATHOM_API_KEY"],
      "_comment": "Fathom work account. Wire API key via 1Password in envFile."
    },
    {
      "id": "fathom-personal",
      "enabled": false,
      "provider": "fathom",
      "ingestCommand": "$HOME/.memroos/integrations/fathom-personal-ingest.sh",
      "envFile": "$HOME/.memroos/agent-keys/fathom-personal.env",
      "outputDir": "$HOME/github/memroos/data/context/meet-recordings-personal",
      "qmdCollections": ["meet-recordings-personal"],
      "schedule": { "hour": 2, "minute": 0 },
      "freshnessThresholdMinutes": 360,
      "requiredTools": ["curl", "python3", "op"],
      "envVars": ["FATHOM_API_KEY"],
      "_comment": "Fathom personal account."
    },
    {
      "id": "zoom",
      "enabled": false,
      "provider": "zoom",
      "ingestCommand": "$HOME/.memroos/integrations/zoom-ingest.sh",
      "envFile": "$HOME/.memroos/agent-keys/zoom.env",
      "outputDir": "$HOME/github/memroos/data/context/meet-recordings-zoom",
      "qmdCollections": ["meet-recordings-zoom"],
      "schedule": { "hour": 4, "minute": 0 },
      "freshnessThresholdMinutes": 1440,
      "requiredTools": ["curl", "python3"],
      "envVars": ["ZOOM_ACCOUNT_ID", "ZOOM_CLIENT_ID", "ZOOM_CLIENT_SECRET"],
      "_comment": "Zoom cloud recordings → VTT → markdown."
    },
    {
      "id": "meet-recordings-fathom",
      "enabled": false,
      "provider": "fathom",
      "ingestCommand": "$HOME/.memroos/integrations/fathom-ingest.sh",
      "envFile": "$HOME/.memroos/agent-keys/fathom.env",
      "outputDir": "$HOME/github/memroos/data/context/meet-recordings-fathom",
      "qmdCollections": ["meet-recordings-fathom"],
      "schedule": { "hour": 3, "minute": 30 },
      "freshnessThresholdMinutes": 360,
      "requiredTools": ["curl", "python3"],
      "envVars": ["FATHOM_API_KEY"],
      "_comment": "Generic single-account Fathom stub for public docs. Prefer fathom-epilogue / fathom-personal when multi-account."
    }
  ]
}
